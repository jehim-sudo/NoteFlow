{
  "id": "/",
  "name": "NoteFlow — Notes, Journal & Planner",
  "short_name": "NoteFlow",
  "description": "NoteFlow keeps your notes, daily journal and task planner in one calm place. Capture ideas and checklists, write or dictate a journal entry each day, plan tasks by time of day, and see it all on a calendar. Everything is stored on your device and works offline.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "portrait",
  "background_color": "#F7F5F1",
  "theme_color": "#4A63C8",
  "categories": ["productivity", "lifestyle", "utilities"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "New note",
      "short_name": "Note",
      "description": "Capture an idea or a checklist",
      "url": "/?new=note",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Write journal entry",
      "short_name": "Journal",
      "description": "Write or dictate today's entry",
      "url": "/?new=journal",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "New task",
      "short_name": "Task",
      "description": "Add something to today's plan",
      "url": "/?new=task",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }]
    }
  ]
