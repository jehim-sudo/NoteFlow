{
  "appId": "com.noteflow.app",
  "appName": "NoteFlow",
  "webDir": "dist",
  "android": {
    "allowMixedContent": false,
    "captureInput": true
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 600,
      "backgroundColor": "#4A63C8",
      "showSpinner": false
    }
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": true
  }
}